<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="FrontEndHealthPets.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:FrontEndHealthPets.Converters"
    xmlns:local="clr-namespace:FrontEndHealthPets">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Converters  -->
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:InverseBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:IsNullOrEmptyConverter x:Key="IsNullOrEmptyConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:StatusCancelVisibleConverter x:Key="StatusCancelVisibleConverter" />
            <converters:StatusColorConverter x:Key="StatusColorConverter" />
            <converters:SelectedColorConverter x:Key="SelectedColorConverter" />

            <!--  Chat Converters  -->
            <converters:FirstLetterConverter x:Key="FirstLetterConverter" />
            <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
            <converters:MessageBubbleColorConverter x:Key="MessageBubbleColorConverter" />
            <converters:MessageAlignmentConverter x:Key="MessageAlignmentConverter" />
            <converters:MessageTextColorConverter x:Key="MessageTextColorConverter" />
            <converters:MessageTimeColorConverter x:Key="MessageTimeColorConverter" />
            <converters:ReadStatusConverter x:Key="ReadStatusConverter" />
            <converters:ConversacionStatusColorConverter x:Key="ConversacionStatusColorConverter" />
            <converters:IsNotActiveConverter x:Key="IsNotActiveConverter" />
            <converters:IsActiveConverter x:Key="IsActiveConverter" />
            <converters:TimeAgoConverter x:Key="TimeAgoConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
