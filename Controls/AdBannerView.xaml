<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FrontEndHealthPets.Controls.AdBannerView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="this">

    <!--  Placeholder banner for ad display  -->
    <!--  Will be replaced with actual AdMob view when SDK is integrated  -->
    <Frame
        x:Name="BannerFrame"
        Margin="10,5"
        Padding="10"
        BackgroundColor="#F5F5F5"
        BorderColor="#E0E0E0"
        CornerRadius="8"
        HeightRequest="60"
        IsVisible="{Binding ShouldShowAds, Source={x:Reference this}}">
        <Grid>
            <Label
                FontSize="12"
                HorizontalOptions="Center"
                Text="📢 Espacio publicitario"
                TextColor="#888888"
                VerticalOptions="Center" />

            <!--  Premium Upgrade Button  -->

        </Grid>
    </Frame>
</ContentView>
