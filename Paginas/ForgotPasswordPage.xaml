<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FrontEndHealthPets.Paginas.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FrontEndHealthPets.ViewModels"
    Title="Recuperar Contraseña"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Image
                HeightRequest="120"
                HorizontalOptions="Center"
                Source="appicon.png"
                WidthRequest="120" />

            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="Center"
                Text="¿Olvidaste tu contraseña?"
                TextColor="#333" />

            <Label
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="Ingresa tu correo electrónico asociado a tu cuenta y te enviaremos un código de verificación."
                TextColor="#666" />

            <Frame
                Padding="5"
                BackgroundColor="White"
                BorderColor="#E0E0E0"
                CornerRadius="10">
                <Entry
                    Keyboard="Email"
                    Placeholder="Correo electrónico"
                    Text="{Binding Email}"
                    TextColor="#333" />
            </Frame>

            <Button
                BackgroundColor="#6B4EE6"
                Command="{Binding SendCodeCommand}"
                CornerRadius="10"
                FontAttributes="Bold"
                HeightRequest="50"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                Text="Enviar Código"
                TextColor="White" />

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#6B4EE6" />

            <Button
                BackgroundColor="Transparent"
                Command="{Binding GoBackCommand}"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Text="Volver al inicio de sesión"
                TextColor="#6B4EE6" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
