<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FrontEndHealthPets.Paginas.VetPortal.VetMyAppointmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mis Citas"
    BackgroundColor="#1a1a2e">

    <Grid RowDefinitions="Auto,*">
        <!--  Filter Tabs  -->
        <ScrollView
            Grid.Row="0"
            HorizontalScrollBarVisibility="Never"
            Orientation="Horizontal">
            <HorizontalStackLayout Padding="15,10" Spacing="10">
                <Button
                    Padding="20,10"
                    BackgroundColor="{Binding AllFilterColor}"
                    Command="{Binding FilterCommand}"
                    CommandParameter=""
                    CornerRadius="20"
                    Text="Todas"
                    TextColor="White" />
                <Button
                    Padding="20,10"
                    BackgroundColor="{Binding PendingFilterColor}"
                    Command="{Binding FilterCommand}"
                    CommandParameter="Pending"
                    CornerRadius="20"
                    Text="Pendientes"
                    TextColor="White" />
                <Button
                    Padding="20,10"
                    BackgroundColor="{Binding ConfirmedFilterColor}"
                    Command="{Binding FilterCommand}"
                    CommandParameter="Confirmed"
                    CornerRadius="20"
                    Text="Confirmadas"
                    TextColor="White" />
                <Button
                    Padding="20,10"
                    BackgroundColor="{Binding CompletedFilterColor}"
                    Command="{Binding FilterCommand}"
                    CommandParameter="Completed"
                    CornerRadius="20"
                    Text="Completadas"
                    TextColor="White" />
            </HorizontalStackLayout>
        </ScrollView>

        <!--  Appointments List  -->
        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView EmptyView="No hay citas con este filtro" ItemsSource="{Binding Appointments}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="15,8"
                            Padding="15"
                            BackgroundColor="#252542"
                            CornerRadius="15"
                            HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

                                <!--  Date & Time  -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    TextColor="#6B4EE6">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding AppointmentDateFormatted}" />
                                            <Span Text=" - " />
                                            <Span Text="{Binding AppointmentTime}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!--  Status Badge  -->
                                <Frame
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="12,6"
                                    BackgroundColor="{Binding StatusColor}"
                                    CornerRadius="10"
                                    HasShadow="False">
                                    <Label
                                        FontSize="12"
                                        Text="{Binding StatusText}"
                                        TextColor="White" />
                                </Frame>

                                <!--  Client Info  -->
                                <StackLayout
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    Spacing="3">
                                    <Label FontSize="15" TextColor="White">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span FontSize="14" Text="👤 " />
                                                <Span FontAttributes="Bold" Text="{Binding UserName}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="14" TextColor="#AAA">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="🐾 " />
                                                <Span Text="{Binding PetName}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>

                                <!--  Reason  -->
                                <Label
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="0,8,0,0"
                                    FontSize="13"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding Reason}"
                                    TextColor="#888" />

                                <!--  Action Buttons  -->
                                <HorizontalStackLayout
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Margin="0,15,0,0"
                                    IsVisible="{Binding CanTakeAction}"
                                    Spacing="10">
                                    <Button
                                        Padding="15,8"
                                        BackgroundColor="#10AC84"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfirmCommand}"
                                        CommandParameter="{Binding Id}"
                                        CornerRadius="8"
                                        IsVisible="{Binding IsPending}"
                                        Text="✓ Confirmar"
                                        TextColor="White" />

                                    <Button
                                        Padding="15,8"
                                        BackgroundColor="#6B4EE6"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CompleteCommand}"
                                        CommandParameter="{Binding Id}"
                                        CornerRadius="8"
                                        IsVisible="{Binding IsConfirmed}"
                                        Text="✓ Completar"
                                        TextColor="White" />

                                    <Button
                                        Padding="15,8"
                                        BackgroundColor="#FF6B6B"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelCommand}"
                                        CommandParameter="{Binding Id}"
                                        CornerRadius="8"
                                        IsVisible="{Binding CanCancel}"
                                        Text="✕ Cancelar"
                                        TextColor="White" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!--  Loading  -->
        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            Color="#6B4EE6" />
    </Grid>
</ContentPage>
