<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FrontEndHealthPets.Paginas.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FrontEndHealthPets.ViewModels"
    Title="Restablecer Contraseña"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="Center"
                Text="Crear nueva contraseña"
                TextColor="#333" />

            <Label
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="Ingresa el código que recibiste en tu correo y tu nueva contraseña."
                TextColor="#666" />

            <!--  Email Display (Read Only)  -->
            <Label
                FontAttributes="Italic"
                HorizontalOptions="Center"
                Text="{Binding Email, StringFormat='Para: {0}'}"
                TextColor="#555" />

            <Frame
                Padding="5"
                BackgroundColor="White"
                BorderColor="#E0E0E0"
                CornerRadius="10">
                <Entry
                    Placeholder="Código de verificación"
                    Text="{Binding Code}"
                    TextColor="#333" />
            </Frame>

            <Frame
                Padding="5"
                BackgroundColor="White"
                BorderColor="#E0E0E0"
                CornerRadius="10">
                <Entry
                    IsPassword="True"
                    Placeholder="Nueva contraseña"
                    Text="{Binding NewPassword}"
                    TextColor="#333" />
            </Frame>

            <Frame
                Padding="5"
                BackgroundColor="White"
                BorderColor="#E0E0E0"
                CornerRadius="10">
                <Entry
                    IsPassword="True"
                    Placeholder="Confirmar contraseña"
                    Text="{Binding ConfirmPassword}"
                    TextColor="#333" />
            </Frame>

            <Button
                BackgroundColor="#6B4EE6"
                Command="{Binding ResetPasswordCommand}"
                CornerRadius="10"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="Restablecer Contraseña"
                TextColor="White" />

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#6B4EE6" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
