    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loca2="clr-namespace:FrontEndHealthPets.Paginas"
    xmlns:local="clr-namespace:FrontEndHealthPets.Paginas.FlyPaginas"
    Title="PagFly">

    <FlyoutPage.Flyout>
        <loca2:PaginaFlyMenu x:Name="flyoutPage" />
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <local:MisMascotas />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>

</FlyoutPage>