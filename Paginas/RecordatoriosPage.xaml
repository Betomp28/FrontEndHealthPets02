<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FrontEndHealthPets.Paginas.RecordatoriosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FrontEndHealthPets.Models"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:vm="clr-namespace:FrontEndHealthPets.ViewModels"
    Title="Mis Recordatorios"
    x:DataType="vm:RecordatoriosViewModel"
    BackgroundColor="#F5F5F5">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding ToggleCreateFormCommand}"
            IconImageSource="add_icon.png"
            Text="+" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">

        <ScrollView>
            <VerticalStackLayout Padding="15" Spacing="15">

                <!--  Header  -->
                <Frame
                    Padding="20"
                    BackgroundColor="#6B4EE6"
                    CornerRadius="15"
                    HasShadow="True">
                    <VerticalStackLayout Spacing="5">
                        <Label
                            FontAttributes="Bold"
                            FontSize="22"
                            Text="🔔 Mis Recordatorios"
                            TextColor="White" />
                        <Label
                            FontSize="14"
                            Text="Vacunas, citas, medicamentos y más"
                            TextColor="#E0E0E0" />
                    </VerticalStackLayout>
                </Frame>

                <!--  Create Form (Collapsible)  -->
                <Frame
                    Padding="15"
                    BackgroundColor="White"
                    CornerRadius="12"
                    HasShadow="True"
                    IsVisible="{Binding ShowCreateForm}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Nuevo Recordatorio"
                            TextColor="#333" />

                        <BoxView BackgroundColor="#E0E0E0" HeightRequest="1" />

                        <!--  Title  -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontSize="12"
                                Text="Título *"
                                TextColor="#666" />
                            <Entry
                                BackgroundColor="#F8F8F8"
                                Placeholder="Ej: Vacuna antirrábica"
                                Text="{Binding NewTitle}" />
                        </VerticalStackLayout>

                        <!--  Message  -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontSize="12"
                                Text="Descripción"
                                TextColor="#666" />
                            <Editor
                                BackgroundColor="#F8F8F8"
                                HeightRequest="80"
                                Placeholder="Detalles del recordatorio..."
                                Text="{Binding NewMessage}" />
                        </VerticalStackLayout>

                        <!--  Type Picker  -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontSize="12"
                                Text="Tipo"
                                TextColor="#666" />
                            <Picker
                                Title="Seleccionar tipo"
                                BackgroundColor="#F8F8F8"
                                ItemsSource="{Binding ReminderTypes}"
                                SelectedItem="{Binding SelectedType}" />
                        </VerticalStackLayout>

                        <!--  Date and Time  -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label
                                    FontSize="12"
                                    Text="Fecha"
                                    TextColor="#666" />
                                <DatePicker
                                    BackgroundColor="#F8F8F8"
                                    Date="{Binding SelectedDate}"
                                    MinimumDate="{x:Static sys:DateTime.Today}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label
                                    FontSize="12"
                                    Text="Hora"
                                    TextColor="#666" />
                                <TimePicker BackgroundColor="#F8F8F8" Time="{Binding SelectedTime}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!--  Pet Picker  -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontSize="12"
                                Text="Mascota (opcional)"
                                TextColor="#666" />
                            <Picker
                                Title="Seleccionar mascota"
                                BackgroundColor="#F8F8F8"
                                ItemDisplayBinding="{Binding Name}"
                                ItemsSource="{Binding Pets}"
                                SelectedItem="{Binding SelectedPet}" />
                        </VerticalStackLayout>

                        <!--  Recurring  -->
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding IsRecurring}" />
                            <Label
                                Text="Recordatorio recurrente"
                                TextColor="#666"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Picker
                            Title="Patrón de repetición"
                            BackgroundColor="#F8F8F8"
                            IsVisible="{Binding IsRecurring}"
                            ItemsSource="{Binding RecurrencePatterns}"
                            SelectedItem="{Binding RecurrencePattern}" />

                        <!--  Buttons  -->
                        <Grid
                            Margin="0,10,0,0"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                BackgroundColor="#E0E0E0"
                                Command="{Binding ToggleCreateFormCommand}"
                                Text="Cancelar"
                                TextColor="#666" />
                            <Button
                                Grid.Column="1"
                                BackgroundColor="#6B4EE6"
                                Command="{Binding CreateRecordatorioCommand}"
                                Text="Crear"
                                TextColor="White" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!--  Quick Add Button  -->
                <Button
                    BackgroundColor="#6B4EE6"
                    Command="{Binding ToggleCreateFormCommand}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    IsVisible="{Binding ShowCreateForm, Converter={StaticResource InverseBoolConverter}}"
                    Text="+ Añadir Recordatorio"
                    TextColor="White" />

                <!--  Recordatorios List  -->
                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Próximos Recordatorios"
                    TextColor="#333" />

                <CollectionView ItemsSource="{Binding Recordatorios}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            Padding="40"
                            HorizontalOptions="Center"
                            Spacing="15"
                            VerticalOptions="Center">
                            <Label
                                FontSize="48"
                                HorizontalOptions="Center"
                                Text="🔔" />
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="No tienes recordatorios"
                                TextColor="#666" />
                            <Label
                                FontSize="13"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="Crea recordatorios para vacunas, citas médicas, medicamentos y más"
                                TextColor="#999" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Recordatorio">
                            <Frame
                                Margin="0,5"
                                Padding="15"
                                BackgroundColor="White"
                                CornerRadius="12"
                                HasShadow="True">
                                <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto">
                                    <!--  Icon based on type  -->
                                    <Frame
                                        Grid.Row="0"
                                        Grid.RowSpan="3"
                                        Grid.Column="0"
                                        Margin="0,0,15,0"
                                        Padding="12"
                                        BackgroundColor="#F0EBFF"
                                        CornerRadius="10"
                                        HasShadow="False"
                                        HeightRequest="50"
                                        WidthRequest="50">
                                        <Label
                                            FontSize="24"
                                            HorizontalOptions="Center"
                                            Text="🔔"
                                            VerticalOptions="Center" />
                                    </Frame>

                                    <!--  Title  -->
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding Title}"
                                        TextColor="#333" />

                                    <!--  Cancel Button  -->
                                    <Button
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="2"
                                        Padding="0"
                                        BackgroundColor="#FFE0E0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecordatoriosViewModel}}, Path=CancelRecordatorioCommand}"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="17"
                                        FontSize="14"
                                        HeightRequest="35"
                                        Text="✕"
                                        TextColor="#D32F2F"
                                        WidthRequest="35" />

                                    <!--  Message  -->
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        FontSize="13"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding Message}"
                                        TextColor="#666" />

                                    <!--  Date  -->
                                    <HorizontalStackLayout
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Spacing="5">
                                        <Label
                                            FontSize="12"
                                            Text="📅"
                                            TextColor="#999" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding FechaProgramada, StringFormat='{0:dd MMM yyyy HH:mm}'}"
                                            TextColor="#999" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <FrontEndHealthPets.Converters.InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
</ContentPage>
