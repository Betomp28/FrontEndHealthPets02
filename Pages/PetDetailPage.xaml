<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FrontEndHealthPets.Pages.PetDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle de Mascota"
    Shell.BackgroundColor="#6C63FF">

    <Grid RowDefinitions="Auto,*">

        <!--  Header with Photo  -->
        <Grid
            x:Name="HeaderGrid"
            Grid.Row="0"
            Padding="0"
            BackgroundColor="#6C63FF"
            HeightRequest="250"
            IsClippedToBounds="True">
            <!--  Pet Photo Background  -->
            <Image
                x:Name="PetPhoto"
                Aspect="AspectFill"
                Opacity="1.0"
                Source="{Binding ProfileImage}"
                TranslationY="{Binding PhotoOffsetY}">
                <Image.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </Image.GestureRecognizers>
            </Image>

            <!--  Gradient Overlay (Darkens bottom for text readability)  -->
            <BoxView x:Name="GradientOverlay" InputTransparent="True">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#40000000" />
                        <GradientStop Offset="0.7" Color="#A06C63FF" />
                        <GradientStop Offset="1.0" Color="#6C63FF" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!--  Save Offset Button (Visible during editing)  -->
            <Button
                x:Name="SaveOffsetButton"
                Margin="0,20,0,0"
                Padding="20,0"
                BackgroundColor="#00D9A5"
                Clicked="SaveOffset_Clicked"
                CornerRadius="20"
                HeightRequest="40"
                HorizontalOptions="Center"
                IsVisible="False"
                Text="Confirmar Ajuste"
                TextColor="White"
                VerticalOptions="Start" />

            <!--  Pet Info  -->
            <VerticalStackLayout
                Padding="20,20,20,30"
                Spacing="8"
                VerticalOptions="End">
                <HorizontalStackLayout Spacing="10">
                    <Label
                        x:Name="PetName"
                        FontAttributes="Bold"
                        FontSize="32"
                        Text="{Binding Name}"
                        TextColor="White" />
                    <Frame
                        x:Name="GenderBadge"
                        Padding="8,4"
                        BackgroundColor="#80FFFFFF"
                        CornerRadius="8"
                        HasShadow="False"
                        VerticalOptions="Center">
                        <Label
                            FontSize="16"
                            Text="♂"
                            TextColor="White" />
                    </Frame>
                </HorizontalStackLayout>

                <Label
                    x:Name="PetBreed"
                    FontSize="18"
                    Opacity="0.9"
                    Text="Golden Retriever"
                    TextColor="White" />

                <HorizontalStackLayout Spacing="15">
                    <Label
                        x:Name="PetAge"
                        FontSize="14"
                        Opacity="0.8"
                        Text="{Binding AgeDisplay}"
                        TextColor="White" />
                    <Label
                        FontSize="14"
                        Opacity="0.8"
                        Text="•"
                        TextColor="White" />
                    <Label
                        x:Name="PetWeight"
                        FontSize="14"
                        Opacity="0.8"
                        Text="{Binding WeightDisplay}"
                        TextColor="White" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!--  Edit Button  -->
            <ImageButton
                Margin="20"
                Padding="8"
                BackgroundColor="White"
                Clicked="Edit_Clicked"
                CornerRadius="20"
                HeightRequest="40"
                HorizontalOptions="End"
                Source="edit.png"
                VerticalOptions="Start"
                WidthRequest="40" />
        </Grid>

        <!--  Content Tabs  -->
        <ScrollView Grid.Row="1" BackgroundColor="#F8F9FA">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!--  Quick Actions  -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <!--  Add Photo  -->
                    <Frame
                        Grid.Column="0"
                        Padding="12"
                        BackgroundColor="White"
                        BorderColor="#DFE6E9"
                        CornerRadius="16"
                        HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AddPhoto_Clicked" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="📷" />
                            <Label
                                FontSize="12"
                                HorizontalOptions="Center"
                                Text="Foto"
                                TextColor="#2D3436" />
                        </VerticalStackLayout>
                    </Frame>

                    <!--  Add Vaccine  -->
                    <Frame
                        Grid.Column="1"
                        Padding="12"
                        BackgroundColor="White"
                        BorderColor="#DFE6E9"
                        CornerRadius="16"
                        HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AddVaccine_Clicked" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="💉" />
                            <Label
                                FontSize="12"
                                HorizontalOptions="Center"
                                Text="Vacuna"
                                TextColor="#2D3436" />
                        </VerticalStackLayout>
                    </Frame>

                    <!--  Add Appointment  -->
                    <Frame
                        Grid.Column="2"
                        Padding="12"
                        BackgroundColor="White"
                        BorderColor="#DFE6E9"
                        CornerRadius="16"
                        HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AddAppointment_Clicked" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="📅" />
                            <Label
                                FontSize="12"
                                HorizontalOptions="Center"
                                Text="Cita"
                                TextColor="#2D3436" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!--  Health Info Card  -->
                <Frame
                    Padding="20"
                    BackgroundColor="White"
                    BorderColor="Transparent"
                    CornerRadius="20"
                    HasShadow="False">
                    <Frame.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.1"
                            Radius="10"
                            Offset="0,2" />
                    </Frame.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Información de Salud"
                            TextColor="#2D3436" />

                        <!--  Color  -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label
                                Grid.Column="0"
                                FontSize="20"
                                Text="🎨"
                                VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    FontSize="12"
                                    Text="Color"
                                    TextColor="#636E72" />
                                <Label
                                    x:Name="PetColor"
                                    FontSize="16"
                                    Text="{Binding Color}"
                                    TextColor="#2D3436" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView BackgroundColor="#F0F3F5" HeightRequest="1" />

                        <!--  Microchip  -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label
                                Grid.Column="0"
                                FontSize="20"
                                Text="🔖"
                                VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    FontSize="12"
                                    Text="Microchip"
                                    TextColor="#636E72" />
                                <Label
                                    x:Name="PetMicrochip"
                                    FontSize="16"
                                    Text="{Binding MicrochipNumber}"
                                    TextColor="#2D3436" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView BackgroundColor="#F0F3F5" HeightRequest="1" />

                        <!--  Birthday  -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label
                                Grid.Column="0"
                                FontSize="20"
                                Text="🎂"
                                VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    FontSize="12"
                                    Text="Fecha de Nacimiento"
                                    TextColor="#636E72" />
                                <Label
                                    x:Name="PetBirthday"
                                    FontSize="16"
                                    Text="{Binding BirthDate, StringFormat='{0:dd MMMM yyyy}'}"
                                    TextColor="#2D3436" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView BackgroundColor="#F0F3F5" HeightRequest="1" />

                        <!--  Notes  -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label
                                Grid.Column="0"
                                Margin="0,2,0,0"
                                FontSize="20"
                                Text="📝"
                                VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    FontSize="12"
                                    Text="Notas"
                                    TextColor="#636E72" />
                                <Label
                                    x:Name="PetNotes"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding Notes}"
                                    TextColor="#2D3436" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!--  Vaccines Section  -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Vacunas"
                            TextColor="#2D3436" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Ver todas →"
                            TextColor="#6C63FF"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ViewAllVaccines_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!--  Vaccine Cards  -->
                    <CollectionView
                        x:Name="VaccinesCollectionView"
                        HeightRequest="150"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="12" Orientation="Horizontal" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    Padding="16"
                                    BackgroundColor="White"
                                    BorderColor="Transparent"
                                    CornerRadius="16"
                                    HasShadow="False"
                                    WidthRequest="200">
                                    <Frame.Shadow>
                                        <Shadow
                                            Brush="Black"
                                            Opacity="0.08"
                                            Radius="8"
                                            Offset="0,2" />
                                    </Frame.Shadow>

                                    <VerticalStackLayout Spacing="8">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Text="{Binding VaccineName}"
                                            TextColor="#2D3436" />
                                        <Label
                                            FontSize="13"
                                            Text="{Binding FormattedDate}"
                                            TextColor="#636E72" />
                                        <Frame
                                            Padding="8,4"
                                            BackgroundColor="{Binding StatusColor}"
                                            CornerRadius="8"
                                            HasShadow="False"
                                            HorizontalOptions="Start">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding StatusDisplay}"
                                                TextColor="White" />
                                        </Frame>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!--  Appointments Section  -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Próximas Citas"
                            TextColor="#2D3436" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Ver todas →"
                            TextColor="#6C63FF"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ViewAllAppointments_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!--  Appointment List  -->
                    <CollectionView x:Name="AppointmentsCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    Margin="0,0,0,12"
                                    Padding="16"
                                    BackgroundColor="White"
                                    BorderColor="Transparent"
                                    CornerRadius="16"
                                    HasShadow="False">
                                    <Frame.Shadow>
                                        <Shadow
                                            Brush="Black"
                                            Opacity="0.08"
                                            Radius="8"
                                            Offset="0,2" />
                                    </Frame.Shadow>

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!--  Date Badge  -->
                                        <Frame
                                            Grid.Column="0"
                                            Padding="12"
                                            BackgroundColor="#F0F3F5"
                                            CornerRadius="12"
                                            HasShadow="False"
                                            HeightRequest="60"
                                            WidthRequest="60">
                                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="20"
                                                    HorizontalOptions="Center"
                                                    Text="{Binding DayNumber}"
                                                    TextColor="#2D3436" />
                                                <Label
                                                    FontSize="11"
                                                    HorizontalOptions="Center"
                                                    Text="{Binding MonthShort}"
                                                    TextColor="#636E72" />
                                            </VerticalStackLayout>
                                        </Frame>

                                        <!--  Appointment Info  -->
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="4"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                Text="{Binding ClinicName}"
                                                TextColor="#2D3436" />
                                            <Label
                                                FontSize="13"
                                                Text="{Binding Reason}"
                                                TextColor="#636E72" />
                                            <Label
                                                FontSize="12"
                                                Text="{Binding TimeDisplay}"
                                                TextColor="#B2BEC3" />
                                        </VerticalStackLayout>

                                        <!--  Status Icon  -->
                                        <Label
                                            Grid.Column="2"
                                            FontSize="24"
                                            Text="›"
                                            TextColor="#DFE6E9"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!--  Photo Gallery  -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Galería de Fotos"
                            TextColor="#2D3436" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="+Agregar"
                            TextColor="#6C63FF"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AddPhoto_Clicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!--  Photo Collection  -->
                    <CollectionView
                        x:Name="PhotosCollectionView"
                        HeightRequest="120"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Frame
                                Padding="20"
                                BackgroundColor="#F8F8F8"
                                CornerRadius="12"
                                HasShadow="False">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Label
                                        FontSize="32"
                                        HorizontalOptions="Center"
                                        Text="📷" />
                                    <Label
                                        FontSize="13"
                                        HorizontalOptions="Center"
                                        Text="Sin fotos aún"
                                        TextColor="#999" />
                                    <Label
                                        FontSize="12"
                                        HorizontalOptions="Center"
                                        Text="Toca +Agregar para subir"
                                        TextColor="#B0B0B0" />
                                </VerticalStackLayout>
                            </Frame>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    Padding="0"
                                    CornerRadius="12"
                                    HasShadow="True"
                                    HeightRequest="100"
                                    WidthRequest="100">
                                    <Grid>
                                        <Image Aspect="AspectFill" Source="{Binding PhotoUrl}" />
                                        <!--  Delete overlay  -->
                                        <Button
                                            Margin="5"
                                            Padding="0"
                                            BackgroundColor="#80000000"
                                            Clicked="DeletePhoto_Clicked"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="12"
                                            FontSize="10"
                                            HeightRequest="24"
                                            HorizontalOptions="End"
                                            Text="✕"
                                            TextColor="White"
                                            VerticalOptions="Start"
                                            WidthRequest="24" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!--  Delete Pet Button  -->
                <Button
                    Margin="0,20,0,0"
                    BackgroundColor="Transparent"
                    Clicked="DeletePet_Clicked"
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="Eliminar Mascota"
                    TextColor="#FF5252" />

                <!--  Extra spacing  -->
                <BoxView HeightRequest="40" Color="Transparent" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
