<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Modern Color Palette  -->

    <!--  Primary Colors - Purple/Pink Gradient Theme  -->
    <Color x:Key="Primary">#667eea</Color>
    <Color x:Key="PrimaryDark">#764ba2</Color>
    <Color x:Key="PrimaryLight">#8B9CF3</Color>

    <!--  Secondary Colors  -->
    <Color x:Key="Secondary">#4ECDC4</Color>
    <Color x:Key="SecondaryDark">#3DBDB5</Color>
    <Color x:Key="SecondaryLight">#7ED7D2</Color>

    <!--  Status Colors  -->
    <Color x:Key="Success">#00D9A5</Color>
    <Color x:Key="Warning">#FFB800</Color>
    <Color x:Key="Error">#FF5252</Color>
    <Color x:Key="Info">#2196F3</Color>

    <!--  Neutral Colors  -->
    <Color x:Key="Background">#F8F9FA</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceVariant">#F5F5F5</Color>

    <!--  Text Colors  -->
    <Color x:Key="TextPrimary">#2D3436</Color>
    <Color x:Key="TextSecondary">#636E72</Color>
    <Color x:Key="TextDisabled">#B2BEC3</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>

    <!--  Border Colors  -->
    <Color x:Key="Border">#DFE6E9</Color>
    <Color x:Key="BorderLight">#F0F3F5</Color>

    <!--  Overlay  -->
    <Color x:Key="Overlay">#80000000</Color>

    <!--  Gradients  -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource Primary}" />
        <GradientStop Offset="1.0" Color="{StaticResource PrimaryDark}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource Secondary}" />
        <GradientStop Offset="1.0" Color="{StaticResource SecondaryDark}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="{StaticResource Primary}" />
        <GradientStop Offset="0.5" Color="{StaticResource PrimaryDark}" />
        <GradientStop Offset="1.0" Color="{StaticResource Secondary}" />
    </LinearGradientBrush>

</ResourceDictionary>